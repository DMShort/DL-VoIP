# ============================================================
# DadLink Voice Server — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# All variables use the VOIP__ prefix with __ as section separator.
# ============================================================

# --- Database ---
POSTGRES_USER=voip
POSTGRES_PASSWORD=voip_secret_change_me
POSTGRES_DB=voip
VOIP__DATABASE__URL=postgresql://voip:voip_secret_change_me@postgres:5432/voip

# --- Security ---
# IMPORTANT: Generate a strong random secret for production!
# Example: openssl rand -hex 32
VOIP__SECURITY__JWT_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHAR_HEX_STRING
VOIP__SECURITY__JWT_EXPIRATION_SECS=3600
VOIP__SECURITY__KEY_ROTATION_MINS=30

# --- Bootstrap (first-run only, creates org + admin user) ---
# These are only used when the database is empty.
VOIP__BOOTSTRAP__ORG_NAME=My Organization
VOIP__BOOTSTRAP__ORG_TAG=myorg
VOIP__BOOTSTRAP__ADMIN_USERNAME=admin
VOIP__BOOTSTRAP__ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- Server ---
VOIP__SERVER__BIND_ADDRESS=0.0.0.0
VOIP__SERVER__CONTROL_PORT=9000
VOIP__SERVER__VOICE_PORT=9001
# TLS (optional — uncomment and provide cert/key paths inside the container)
# VOIP__SERVER__TLS_CERT_PATH=/app/certs/server.crt
# VOIP__SERVER__TLS_KEY_PATH=/app/certs/server.key

# --- Voice ---
VOIP__VOICE__MAX_PACKET_RATE=100
VOIP__VOICE__BUFFER_POOL_SIZE=256

# --- Audit ---
VOIP__AUDIT__RETENTION_DAYS=90

# --- Logging ---
# Options: error, warn, info, debug, trace
# Use voip_server=debug for verbose server logs
RUST_LOG=voip_server=info
